###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=your-secret-key-here-change-in-production
# DEFAULT_URI est construit automatiquement : http://${COMPOSE_PROJECT_NAME}.docker.localhost
###< symfony/framework-bundle ###

###> docker ###
COMPOSE_PROJECT_NAME=sso
# APP_DOMAIN est construit automatiquement : ${COMPOSE_PROJECT_NAME}.docker.localhost
# APP_DOMAIN_DEVHOST est construit automatiquement : ${COMPOSE_PROJECT_NAME}.docker.devhost

# Chemin vers docker-dev-host (utilisé pour démarrer automatiquement Traefik)
DOCKER_DEV_HOST_PATH=/home/jgaub@niji.fr/Public/Project/docker-dev-host

# Database
# Note: DATABASE_URL est construite automatiquement par docker-compose.yml à partir de ces variables
# Format: postgresql://${DB_USER}:${DB_PASSWORD}@database:5432/${DB_NAME}?serverVersion=${DB_SERVER_VERSION}&charset=utf8
DB_SERVER_VERSION=16
DB_USER=symfony
DB_PASSWORD=your-db-password-here
DB_NAME=symfony

# Redis
REDIS_VERSION=7-alpine

# Xdebug
XDEBUG_ENABLE=1
SYMFONY_CONTAINER_XML_PATH=
###< docker ###

###> SSO OAuth2 (si applicable) ###
# Exemple pour un provider SSO générique
# SSO_CLIENT_ID=your-client-id-here
# SSO_CLIENT_SECRET=your-client-secret-here
# SSO_AUTHORIZATION_URL=https://provider.com/oauth/authorize
# SSO_TOKEN_URL=https://provider.com/oauth/token
# SSO_USERINFO_URL=https://provider.com/oauth/userinfo
# SSO_SCOPES=openid profile email
###< SSO OAuth2 ###


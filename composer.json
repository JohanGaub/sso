{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "symfony/console": "8.*",
        "symfony/dotenv": "8.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.*",
        "symfony/runtime": "8.*",
        "symfony/yaml": "8.*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93.1",
        "phpmd/phpmd": "3.x-dev",
        "phpstan/phpstan": "^2.1.38",
        "phpstan/phpstan-doctrine": "^2.0.14",
        "phpstan/phpstan-symfony": "^2.0.12",
        "phpunit/phpunit": "^12.5.8",
        "rector/rector": "^2.3.5",
        "symfony/maker-bundle": "^1.65",
        "symfony/phpunit-bridge": "^8.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "phpstan": "phpstan analyse",
        "phpstan:baseline": "phpstan analyse --generate-baseline",
        "rector": "rector process",
        "rector:dry-run": "rector process --dry-run",
        "rector:clear-cache": "rector clear-cache",
        "php-cs-fixer": "php-cs-fixer fix",
        "php-cs-fixer:dry-run": "php-cs-fixer fix --dry-run --diff",
        "phpmd": "phpmd analyze src --format text --ruleset phpmd.xml --ignore-violations-on-exit",
        "security-audit": "composer audit",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html var/coverage",
        "quality": [
            "@security-audit",
            "@php-cs-fixer:dry-run",
            "@phpmd",
            "@phpstan",
            "@rector:dry-run"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.*"
        }
    }
}

<?xml version="1.0"?>
<ruleset name="SSO Project Rules"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0
                     http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="
                     http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
        Règles PHPMD pour le projet SSO
    </description>

    <!-- Exclure les fichiers générés -->
    <exclude-pattern>*/Kernel.php</exclude-pattern>
    <exclude-pattern>*/reference.php</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/var/*</exclude-pattern>

    <!-- Règles de code -->
    <rule ref="rulesets/codesize.xml"/>

    <!-- Règles de design -->
    <rule ref="rulesets/design.xml"/>

    <!-- Règles de nommage -->
    <rule ref="rulesets/naming.xml">
        <!-- Noms de variables trop courts -->
        <exclude name="ShortVariable"/>
        <!-- Noms de méthodes trop courts -->
        <exclude name="ShortMethodName"/>
    </rule>

    <!-- Règles de code mort -->
    <rule ref="rulesets/unusedcode.xml"/>

    <!-- Règles de code controversé -->
    <rule ref="rulesets/controversial.xml">
        <!-- CamelCase pour les noms de variables -->
        <exclude name="CamelCaseVariableName"/>
    </rule>

    <!-- Règles de nettoyage -->
    <rule ref="rulesets/cleancode.xml">
        <!-- Méthodes statiques -->
        <exclude name="StaticAccess"/>
    </rule>

</ruleset>
